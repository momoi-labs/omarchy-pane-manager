#!/usr/bin/env python3
"""Emit, as JSON lines, where a dragged pane would land if dropped right now.

Hyprland exposes no drag event, but it does not need to: dragging a *tiled*
window with the move bind flips it to floating for the duration of the drag
(DragController.cpp, `changeFloatingMode` in updateDragWindow / dragEnd), and
that flip is announced on socket2 as `changefloatingmode`. So drag start and
drag end arrive as push events, and the cursor is only polled in between.

The landing side is decided by Hyprland in DwindleAlgorithm.cpp:

    DELTA       = cursor - targetBoxCenter
    PROPORTIONS = box.h / box.w
    |DELTA.y / DELTA.x| < PROPORTIONS -> left/right by sign of DELTA.x
                                    else -> up/down    by sign of DELTA.y

which cuts the target along its own diagonals. This mirrors that exactly; if
Hyprland changes the rule, this lies, so it is pinned to a version below.
"""
import json, os, socket, sys, time

HYPRLAND_RULE_VERIFIED_ON = "0.56.2"
POLL_HZ = 60

XDG = os.environ.get("XDG_RUNTIME_DIR", "")
SIG = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
BASE = f"{XDG}/hypr/{SIG}"


def request(cmd):
    """One request on Hyprland's command socket; it closes after each reply."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(f"{BASE}/.socket.sock")
        s.sendall(cmd.encode())
        chunks = []
        while True:
            b = s.recv(65536)
            if not b:
                break
            chunks.append(b)
    return b"".join(chunks)


def request_json(cmd):
    try:
        return json.loads(request("j/" + cmd))
    except Exception:
        return None


def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def option(name, key):
    v = request_json(f"getoption {name}")
    return v.get(key) if isinstance(v, dict) else None


def landing_box(cursor, box, split_ratio):
    """Hyprland's rule, then the half of `box` the new pane would occupy."""
    x, y, w, h = box
    if w <= 0 or h <= 0:
        return None
    cx, cy = x + w / 2.0, y + h / 2.0
    dx, dy = cursor[0] - cx, cursor[1] - cy
    proportions = h / w

    # Vertical centre line: dx == 0 has infinite slope, so it is up/down.
    horizontal = abs(dy / dx) < proportions if dx else False

    if horizontal:
        first = w / 2.0 * split_ratio
        if dx > 0:  # lands right, taking the second child
            return ("right", (x + first, y, w - first, h))
        return ("left", (x, y, first, h))

    first = h / 2.0 * split_ratio
    if dy > 0:  # lands below
        return ("down", (x, y + first, w, h - first))
    return ("up", (x, y, w, first))


def workspace_layout(ws_id):
    """The layout in force on one workspace. Not `general:layout`: that is only
    the fallback, and a workspace rule — which is how Omarchy's own toggle pins
    a workspace to scrolling — overrides it per workspace."""
    for w in request_json("workspaces") or []:
        if w.get("id") == ws_id:
            return w.get("tiledLayout")
    return None


def window_box(c):
    return (c["at"][0], c["at"][1], c["size"][0], c["size"][1])


def rect_distance_sq(point, box):
    """Hyprland's vecToRectDistanceSquared: 0 inside the box, otherwise the
    squared distance from the point to its nearest edge."""
    x, y, w, h = box
    dx = max(0.0, x - point[0], point[0] - (x + w))
    dy = max(0.0, y - point[1], point[1] - (y + h))
    return dx * dx + dy * dy


def pick_target(clients, cursor, dragged_addr, workspace_id):
    """Mirror which pane Hyprland splits when a drag is dropped.

    DwindleAlgorithm tries the focused window first when
    dwindle:use_active_for_splits is on — but it also requires that window to be
    something other than the one being placed (`ACTIVE_WINDOW !=
    target->window()`), and during a drop those are the same window. So the
    branch always falls through to getClosestNode(cursor, dragged): the leaf
    nearest the cursor, zero distance meaning the cursor is inside it. With the
    option off the code hit tests the cursor instead, which gives the same
    answer whenever the cursor is over a pane, so one rule covers both.
    """
    best = None
    best_distance = None
    for c in clients:
        if c["floating"] or not c["mapped"]:
            continue
        if c["workspace"]["id"] != workspace_id or c["address"] == dragged_addr:
            continue
        distance = rect_distance_sq(cursor, window_box(c))
        if best_distance is None or distance < best_distance:
            best, best_distance = c, distance
    return best


def main():
    if not XDG or not SIG:
        emit({"error": "not running under Hyprland"})
        return 1

    sock2 = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock2.connect(f"{BASE}/.socket2.sock")
    sock2.settimeout(0)

    dragging = None
    buf = b""
    period = 1.0 / POLL_HZ

    while True:
        try:
            chunk = sock2.recv(65536)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                ev = line.decode(errors="replace")
                if not ev.startswith("changefloatingmode>>"):
                    continue
                addr, mode = (ev.split(">>", 1)[1].split(",") + ["", ""])[:2]
                addr = "0x" + addr if not addr.startswith("0x") else addr

                if mode == "1" and dragging is None:
                    # A tiled window just went floating. A drag centres it on
                    # the cursor; a manual float toggle leaves it put. That is
                    # what tells the two apart.
                    cur = request_json("cursorpos")
                    cl = request_json("clients") or []
                    me = next((c for c in cl if c["address"] == addr), None)
                    if not me or not cur:
                        continue
                    x, y, w, h = window_box(me)
                    near = abs((x + w / 2) - cur["x"]) < 8 and abs((y + h / 2) - cur["y"]) < 8
                    # With precise_mouse_move off Hyprland only tiles left or
                    # right, so a four-way indicator would be promising
                    # something it will not deliver. Stay quiet instead.
                    if near and option("dwindle:precise_mouse_move", "bool"):
                        dragging = {
                            "addr": addr,
                            "ws": me["workspace"]["id"],
                            "ratio": option("dwindle:default_split_ratio", "float") or 1.0,
                            # The indicator draws the shape the pane will have,
                            # so it takes its corners from Hyprland, not the
                            # shell theme.
                            "rounding": option("decoration:rounding", "int") or 0,
                        }
                elif mode == "0" and dragging and dragging["addr"] == addr:
                    dragging = None
                    emit({"dragging": False})
        except BlockingIOError:
            pass
        except (OSError, ValueError):
            pass

        if dragging is None:
            time.sleep(0.05)
            continue

        cur = request_json("cursorpos")
        clients = request_json("clients")
        if not cur or clients is None:
            time.sleep(period)
            continue

        # Read the workspace off the dragged window every frame rather than
        # caching it: dragging across monitors moves the window to the
        # workspace it lands on, and the target has to follow.
        me = next((c for c in clients if c["address"] == dragging["addr"]), None)
        workspace = me["workspace"]["id"] if me else dragging["ws"]

        # The geometry below is dwindle's. Dragging onto a scrolling workspace
        # means the pane joins a row instead of splitting anything, so there is
        # no half to shade — and since a drag can cross into one, this is
        # re-read whenever the workspace under the drag changes.
        if workspace != dragging.get("layout_of"):
            dragging["layout_of"] = workspace
            dragging["layout"] = workspace_layout(workspace)
        if dragging["layout"] != "dwindle":
            if dragging.get("shown"):
                dragging["shown"] = False
                emit({"dragging": False})
            time.sleep(period)
            continue

        target = pick_target(clients, (cur["x"], cur["y"]), dragging["addr"],
                             workspace)
        if target:
            res = landing_box((cur["x"], cur["y"]), window_box(target),
                              dragging["ratio"])
            if res:
                direction, (bx, by, bw, bh) = res
                dragging["shown"] = True
                emit({"dragging": True, "dir": direction,
                      "x": round(bx), "y": round(by),
                      "w": round(bw), "h": round(bh),
                      "r": dragging["rounding"]})
        time.sleep(period)
    return 0


if __name__ == "__main__":
    sys.exit(main())
